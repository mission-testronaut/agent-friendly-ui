{
  "name": "@agent-friendly-ui/utils",
  "version": "0.1.0",
  "description": "TypeScript utilities for building agent-friendly web interfaces for AI browser agents and agentic testing.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent-friendly",
    "agent-friendly-ui",
    "agentic-ui",
    "ai-agents",
    "browser-agents",
    "agentic-testing",
    "llm",
    "playwright",
    "accessibility",
    "automation",
    "testing",
    "ui",
    "data-attributes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  },
  "homepage": "https://github.com/mission-testronaut/agent-friendly-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mission-testronaut/agent-friendly-ui.git",
    "directory": "packages/agent-friendly-ui-utils"
  }
}
